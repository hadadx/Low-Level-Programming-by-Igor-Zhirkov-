{
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500,

    "files.associations": {
        "*.asm": "asm",
        "*.inc": "asm",
        "*.s": "asm"
    },

    "files.exclude": {
        "**/*.o": true,
        "**/*.swp": true,
        "**/*.swo": true,
        "**/.gdb_history": true
    },
    "search.exclude": {
        "**/*.o": true
    },

    "debug.disassemblyView.showSourceCode": true,
    "debug.inlineValues": "on",

    "editor.rulers": [80],
    "editor.minimap.enabled": true
}
