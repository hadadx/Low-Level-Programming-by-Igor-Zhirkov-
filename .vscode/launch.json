{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: main (Makefile project)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${fileDirname}/main",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "externalConsole": false,
            "stopAtEntry": true,
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Debug: current file (standalone)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "externalConsole": false,
            "stopAtEntry": true,
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
